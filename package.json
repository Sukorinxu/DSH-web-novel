{
  "name": "dsh-web-novel",
  "version": "1.16.1",
  "description": "AI 写长篇的四个死法：设定崩、看不见前文、水文超字数、满屏 AI 味——这个插件全用代码堵死。细纲不批准就不给写章，设定改值直接拒绝，重复句段机审拦下，六维去 AI 味扫描零 token。右侧栏锻炉面板带听书、全书体检、批量起草断点续跑；23 个 novel_* 工具，你只管讲故事，把关交给代码。Novel-writing guardrails plugin for DeepSeek Harness (DSH).",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "novel-writing",
    "ai-writing",
    "creative-writing",
    "小说",
    "网文",
    "连载",
    "起点",
    "番茄",
    "去AI味"
  ],
  "license": "MIT",
  "author": "huangziyuan-general",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sukorinxu/DSH-web-novel.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "README.md",
    "README.en.md",
    "cordis.patch.yml",
    "lib",
    "mcp",
    "skills"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:fallback": "node scripts/build-client-fallback.mjs",
    "build:patch": "node scripts/build-fusion-patch.mjs",
    "audit": "node scripts/audit-static.mjs && node scripts/audit-lib-calls.mjs",
    "preview": "npm run build && node scripts/preview-ui.mjs",
    "pretest": "npm run build && npm run audit",
    "test": "node --test test/*.test.mjs",
    "test:stubs": "node scripts/setup-test-stubs.mjs",
    "test:stubs:clean": "node scripts/setup-test-stubs.mjs --remove",
    "fusion:e2e": "node scripts/fusion-e2e.mjs",
    "setup-dev": "node scripts/setup-dev-links.mjs",
    "realboot": "node scripts/real-boot-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "bin": {
    "dsh-web-novel-mcp": "./mcp/server.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  }
}
